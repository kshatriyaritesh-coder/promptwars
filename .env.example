# ==========================================
# BreatheWell / SaansSaathi Environment Variables
# ==========================================

# Google Gemini API Key for Grounded AI Assistant (Get from Google AI Studio: https://aistudio.google.com)
VITE_GEMINI_API_KEY=

# World Air Quality Index (WAQI / AQICN) API Token (Optional free token from https://aqicn.org/api/)
VITE_WAQI_API_TOKEN=

# Application Environment (development, production)
VITE_APP_ENV=development
